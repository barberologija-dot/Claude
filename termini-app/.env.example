# Copy to .env.local for local development. These two values are public
# (they are visible in the browser); the database rules protect the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: Cloudflare Turnstile site key (bot check on sign-up)
VITE_TURNSTILE_SITE_KEY=
